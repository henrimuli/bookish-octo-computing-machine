# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL: transaction pooler (port 6543), used by the app.
# DIRECT_DATABASE_URL: direct or session connection (port 5432), used for migrations.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional social sign-in. Callback URLs: {SITE_URL}/api/auth/callback/google and /github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (Resend). Without a key, emails are printed to the console in development.
RESEND_API_KEY=
EMAIL_FROM="DebutYard <hello@debutyard.com>"
ADMIN_EMAIL=

# Paystack → Settings → API Keys & Webhooks. Use sk_test_... until you go live.
# Webhook URL: {SITE_URL}/api/webhooks/paystack
PAYSTACK_SECRET_KEY=

# PayPal → developer.paypal.com → Apps & Credentials. Webhook URL: {SITE_URL}/api/webhooks/paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Cloudflare R2 → R2 → Manage API tokens (Object Read & Write on the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=debutyard
R2_PUBLIC_URL=https://cdn.debutyard.com

# Vercel Cron bearer token. Generate with: openssl rand -hex 32
CRON_SECRET=
